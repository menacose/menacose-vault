  "customTokensStr": "registerCustomToken('menacoseAttachmentFolder', (ctx) => {\n  const imageExtensions = new Set(['avif', 'bmp', 'gif', 'heic', 'heif', 'ico', 'jpe', 'jpeg', 'jpg', 'png', 'svg', 'tif', 'tiff', 'webp']);\n  if (!imageExtensions.has(ctx.attachmentFileExtension.toLowerCase())) {\n    return '90_Attachments';\n  }\n  const isoYearAndWeek = ctx.obsidian.moment().format('GGGG/[W]WW');\n  return '90_Attachments/90.01_Images/' + isoYearAndWeek;\n});",
  "defaultImageSize": "",
  "defaultImageSizeDimension": "width",
  "downloadNetworkImages": false,
  "duplicateNameSeparator": " ",
